// Prisma Schema for Coderaxo Connect
// Multi-tenant team communication platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  GUEST
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

// ─── Models ──────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  firstName       String
  lastName        String
  name            String   // Full name (computed from first + last)
  email           String   @unique
  password        String
  avatar          String?
  designation     String?
  emailVerified   Boolean  @default(false)
  verificationToken String? @unique
  isOnline        Boolean  @default(false)
  lastSeen        DateTime @default(now())
  isSystemAdmin   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Multi-workspace memberships
  workspaceMemberships WorkspaceMember[]
  createdWorkspaces    Workspace[]       @relation("WorkspaceCreator")

  // Channel / messaging
  channelMemberships ChannelMember[]
  messages           Message[]
  reactions          Reaction[]
  pinnedMessages     Message[] @relation("PinnedMessages")

  // DM relationships
  conversationsAsUser1 DirectConversation[] @relation("User1Conversations")
  conversationsAsUser2 DirectConversation[] @relation("User2Conversations")

  // Team relationships
  teamMemberships TeamMember[]
  ledTeams        Team[]       @relation("TeamLead")
  managedTeams    Team[]       @relation("TeamManager")

  // Project relationships
  projectMemberships ProjectMember[]
  managedProjects    Project[]       @relation("ProjectManager")
  assignedTasks      TaskAssignee[]
  reportedTasks      Task[]          @relation("TaskReporter")

  // Invites sent
  sentInvites     WorkspaceInvite[] @relation("InviteSender")

  // Knowledge Base
  authoredArticles    KnowledgeArticle[]
  knowledgeFavorites  KnowledgeFavorite[]
  articleEdits        KnowledgeArticleHistory[]
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User   @relation("WorkspaceCreator", fields: [createdById], references: [id])

  members  WorkspaceMember[]
  channels Channel[]
  teams    Team[]
  projects Project[]
  invites  WorkspaceInvite[]

  // Knowledge Base
  knowledgeCategories KnowledgeCategory[]
  knowledgeArticles   KnowledgeArticle[]
}

model WorkspaceMember {
  id        String        @id @default(uuid())
  role      WorkspaceRole @default(MEMBER)
  joinedAt  DateTime      @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model WorkspaceInvite {
  id        String       @id @default(uuid())
  email     String
  role      WorkspaceRole @default(MEMBER)
  token     String       @unique
  status    InviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime     @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([email, workspaceId])
}

model Channel {
  id          String   @id @default(uuid())
  name        String
  description String?
  isPrivate   Boolean  @default(false)
  isAdminOnly Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  members  ChannelMember[]
  messages Message[]

  @@unique([name, workspaceId])
}

model ChannelMember {
  userId    String
  channelId String
  joinedAt  DateTime @default(now())
  lastReadAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
}

model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sender
  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Channel message (nullable — null means it's a DM)
  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  // Direct message (nullable — null means it's a channel message)
  conversationId String?
  conversation   DirectConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  attachments  Attachment[]
  linkPreviews LinkPreview[]
  reactions    Reaction[]

  // Thread Replies
  parentId String?
  parent   Message?  @relation("ThreadReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Message[] @relation("ThreadReplies")

  // Pinned Messages
  isPinned   Boolean   @default(false)
  pinnedAt   DateTime?
  pinnedById String?
  pinnedBy   User?     @relation("PinnedMessages", fields: [pinnedById], references: [id])
}

model Attachment {
  id       String @id @default(uuid())
  url      String
  fileName String
  fileType String
  createdAt DateTime @default(now())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model LinkPreview {
  id          String   @id @default(uuid())
  url         String
  title       String?
  description String?
  image       String?
  favicon     String?
  siteName    String?
  
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model DirectConversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1Id String
  user1   User   @relation("User1Conversations", fields: [user1Id], references: [id], onDelete: Cascade)
  user1LastReadAt DateTime @default(now())

  user2Id String
  user2   User   @relation("User2Conversations", fields: [user2Id], references: [id], onDelete: Cascade)
  user2LastReadAt DateTime @default(now())

  messages Message[]

  @@unique([user1Id, user2Id])
}

model Reaction {
  id        String   @id @default(uuid())
  emoji     String
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
}

model Team {
  id          String   @id @default(uuid())
  name        String
  handle      String?
  description String?
  avatar      String?
  coverImage  String?
  colorTheme  String?
  department  String?
  visibility  String   @default("Private")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  managerId   String?
  manager     User?     @relation("TeamManager", fields: [managerId], references: [id])

  leadId      String?
  lead        User?     @relation("TeamLead", fields: [leadId], references: [id])

  members     TeamMember[]
  projects    Project[]

  @@unique([name, workspaceId])
  @@unique([handle, workspaceId])
}

model TeamMember {
  userId    String
  teamId    String
  role      String   @default("Member")
  joinedAt  DateTime @default(now())

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
}

model Project {
  id          String   @id @default(uuid())
  name        String
  key         String
  nextIssueNumber Int @default(1)
  description String?
  client      String?
  category    String?
  priority    String   @default("Medium")
  status      String   @default("Active")
  startDate   DateTime?
  deadline    DateTime?
  color       String   @default("#8b5cf6")
  logo        String?
  progress    Int      @default(0)
  isFavorite  Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  managerId   String?
  manager     User?     @relation("ProjectManager", fields: [managerId], references: [id])

  teamId      String?
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  members     ProjectMember[]
  tasks       Task[]

  @@index([workspaceId])
  @@unique([key, workspaceId])
}

model ProjectMember {
  id         String   @id @default(uuid())
  role       String   @default("Member")
  department String?
  joinedAt   DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String   @default("Task")
  issueNumber Int
  issueKey    String   @unique
  status      String   @default("To Do")
  priority    String   @default("Medium")
  dueDate     DateTime?
  labels      String[]
  attachments Int      @default(0)
  comments    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  reporterId  String?
  reporter    User?    @relation("TaskReporter", fields: [reporterId], references: [id])

  assignees   TaskAssignee[]

  @@index([projectId])
}

model TaskAssignee {
  userId     String
  taskId     String
  assignedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId])
}

// ─── Knowledge Base ──────────────────────────────────────

model KnowledgeCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  articles    KnowledgeArticle[]
  
  @@unique([name, workspaceId])
}

model KnowledgeArticle {
  id          String   @id @default(uuid())
  title       String
  content     String   
  coverImage  String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  categoryId  String
  category    KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  authorId    String
  author      User      @relation(fields: [authorId], references: [id])

  favorites   KnowledgeFavorite[]
  history     KnowledgeArticleHistory[]

  @@index([workspaceId])
  @@index([categoryId])
}

model KnowledgeFavorite {
  userId      String
  articleId   String
  createdAt   DateTime @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  article     KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
}

model KnowledgeArticleHistory {
  id          String   @id @default(uuid())
  articleId   String
  version     Int
  title       String
  content     String
  coverImage  String?
  tags        String[]
  createdAt   DateTime @default(now())

  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  
  article     KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}
